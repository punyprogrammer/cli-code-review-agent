{
  "name": "repo-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI code review agent built on Vercel Sandbox, the Vercel Academy course project",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "review": "tsx --env-file=.env src/cli.ts review"
  },
  "dependencies": {
    "@vercel/sandbox": "3.9.0",
    "ai": "7.0.154",
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
